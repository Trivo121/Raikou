[Unit]
Description=SARChat InternVL2.5-2B vLLM server (NVIDIA T4 variant)
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
Restart=always
RestartSec=10
ExecStartPre=-/usr/bin/docker rm -f sarchat-vllm
# Variant of sarchat-vllm.service for a g4dn instance (one 16 GB Tesla T4, 15 GB
# usable). Running on the box since 2026-10-13; the model answered text and
# image prompts correctly on it. Differences from the A10G unit:
#
#   --dtype half              Turing (compute capability 7.5) has no bf16, and
#                             the model's own dtype is bf16, so vLLM refuses to
#                             start without this.
#   --gpu-memory-utilization 0.55, --max-num-seqs 1
#                             ~8.1 GB resident, leaving ~7 GB for the GPU
#                             worker, whose models peak near 1.7 GB.
#   --enforce-eager           skips CUDA-graph capture, which costs memory and
#                             time at start-up on a small card.
#
# vLLM (v0.24) falls back to its Triton attention backend on its own, because
# FlashAttention 2 needs compute capability 8.0 or higher. Pair this unit with
# sar-backend-sarclip-cpu.override.conf. Install as /etc/systemd/system/
# sarchat-vllm.service in place of the A10G unit.
#
# Original budget, on a 23 GB A10G shared with the SARCLIP encoder:
#
#   max-model-len 16384 - the model itself supports 32768; 4096 was far too
#     small for this workload. InternVL2.5 renders one image as up to 12
#     448px tiles plus a thumbnail at 256 tokens each (~3300 tokens per
#     image), so an overview + its four quadrant samples + retrieved patch
#     previews reached ~9650 tokens and every scene-description request was
#     rejected with "Input length exceeds model's maximum context length".
#   gpu-memory-utilization 0.60 - KV cache is 96 KiB/token, so 16384 tokens
#     x 2 sequences needs ~3 GB against ~0.75 GB at 4096. 0.45 could not fund
#     it. 0.60 is ~13.8 GB and still leaves ~7 GB for the SARCLIP worker
#     (~2 GB resident) plus headroom.
#   limit-mm-per-prompt image:12 - the API can attach up to 10 images
#     (6 artifacts + 4 overview quadrants); the previous limit of 6 would
#     have rejected scene-description prompts on image count alone.
ExecStart=/usr/bin/docker run --rm --name sarchat-vllm --gpus all --restart=no -v /home/ubuntu/backend/models:/models -p 127.0.0.1:8001:8000 vllm/vllm-openai:latest --model /models/SARChat-InternVL2.5-2B --trust-remote-code --dtype half --gpu-memory-utilization 0.55 --max-model-len 16384 --max-num-seqs 1 --enforce-eager --limit-mm-per-prompt {\"image\":12}
ExecStop=/usr/bin/docker stop -t 30 sarchat-vllm

[Install]
WantedBy=multi-user.target
